  "version": "0.1.0",
  "type": "module",
  "description": "The borrower realm, rebuilt. One installable app: verify once, apply, track and repay.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
