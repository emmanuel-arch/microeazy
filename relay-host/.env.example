# ─────────────────────────────────────────────────────────────────────────────
# RELAY HOST .env  —  copy to `.env` (same folder as package.json) and fill in.
#
# BOTH scripts read THIS file, from the bundle root:
#   sql-relay.ts   via dotenv, relative to the working directory
#   crb-relay.mjs  via its own tiny parser, at ../.env relative to the script
#
# So the layout matters. Keep .env beside package.json, not inside scripts/.
# Nothing here belongs on Vercel except the two SECRET values, which must match
# byte for byte.
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL RELAY (port 8787) ────────────────────────────────────────────────────
# Only needed if this host is running the SQL relay. It must be able to reach
# 100.72.35.56,4230 — run check-host.ps1 to confirm before bothering.

# Must be identical to SERVICESUITE_RELAY_SECRET on Vercel. At least 32 chars,
# or the relay refuses to start rather than be an open SQL proxy.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICESUITE_RELAY_SECRET=""

# Micromart's book. This is the credential that never goes near Vercel.
SERVICESUITE_CONN_MICROMART=""

# Optional. The relay warms pools for micromart and axe at boot; a missing one
# is skipped, not an error.
SERVICESUITE_CONN_AXE=""

# Relay-host-only knobs. Defaults are correct — listed so you know they exist.
# SQL_RELAY_PORT=8787
# SQL_RELAY_HOST=127.0.0.1
# SQL_RELAY_ALLOW_WRITES=false     # leave false: writes refused at the socket

# ── CRB RELAY (port 8788) ────────────────────────────────────────────────────
# Only needed if this host's PUBLIC EGRESS IP is on Metropol's whitelist.
# The relay prints that address on boot and tells you whether it qualifies.

# Must be identical to CRB_RELAY_SECRET on Vercel.
CRB_RELAY_SECRET=""

# CRB_RELAY_PORT=8788
# CRB_RELAY_HOST=127.0.0.1

# NOT NEEDED HERE: the Metropol key pair. Keys stay in the caller's vault and
# pass through this relay as opaque headers.
